# Optional. Without it the cascade runs rules + local classifier and sends the uncertain band to human review.
OPENAI_API_KEY=
# Pinned snapshot, so a silent provider update cannot change behaviour (re-run `pnpm eval` before bumping).
LLM_MODEL=gpt-5.4-mini-2026-03-17
OCR_MODEL=gpt-5.4-mini-2026-03-17
# A different model reads only the identifiers a second time; disagreement means "do not match on it".
# Empty switches the second read off (handwritten identifiers then always go to a person).
OCR_SECOND_READ_MODEL=gpt-5.4-2026-03-05
# Stage 2 model: tfidf (default, won the evaluation) or embeddings (multilingual-e5-small, local ONNX).
LOCAL_MODEL=tfidf
EMBEDDING_MODEL=Xenova/multilingual-e5-small
HF_CACHE_DIR=var/hf-cache
LLM_ENABLED=true
PORT=3000
DATABASE_PATH=var/doc-router.sqlite
LLM_CACHE_DIR=var/llm-cache
LOG_LEVEL=info
# Off by default: the cache stores letter text and OCR output on disk. `pnpm eval` enables it for itself.
LLM_CACHE_ENABLED=false
# Required to submit documents as OGNIVO / E_DORECZENIA or with a declaredClass (header X-Integration-Token).
INTEGRATION_TOKEN=
# Only for `pnpm scans:generate` (renders test letters as images with gpt-image-2 on fal.ai).
FAL_API_KEY=
