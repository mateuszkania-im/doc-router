{
  "name": "doc-router",
  "version": "0.1.0",
  "private": true,
  "description": "Incoming correspondence classification and routing PoC for a Polish financial company",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --disable-warning=ExperimentalWarning watch src/server.ts",
    "start": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "classify": "tsx --disable-warning=ExperimentalWarning src/cli/classify.ts",
    "train": "tsx --disable-warning=ExperimentalWarning src/cli/train.ts",
    "eval": "tsx --disable-warning=ExperimentalWarning src/cli/eval.ts",
    "dataset:generate": "tsx --disable-warning=ExperimentalWarning scripts/generate-dataset.ts",
    "scans:generate": "tsx --disable-warning=ExperimentalWarning scripts/generate-scans.ts",
    "eval:scans": "tsx --disable-warning=ExperimentalWarning src/cli/eval-scans.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^4.3.2",
    "hono": "^4.13.14",
    "openai": "^7.47.0",
    "pino": "^10.4.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
